  ggplot2::geom_line(ggplot2::aes(linewidth = lake)) +
  ggplot2::geom_point(ggplot2::aes(size = lake, alpha = lake)) +
  scale_focus_plus(aes = c("colour", "linewidth", "size", "alpha"),
